# ==============================================
# KANBAN TASKS BOARD - VARIABLES DE ENTORNO
# ==============================================

# Puerto del Servidor Backend
PORT=3001
NODE_ENV=development

# URL del Frontend (para CORS y redirecciones OAuth)
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL
DATABASE_URL=postgresql://kanban_user:kanban_secure_password@localhost:5432/kanban_tasks_db?schema=public

# Clave secreta para JWT y Cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=desarrollo_secreto_super_seguro_minimo_32_caracteres_12345

# Credenciales de Google Cloud OAuth 2.0
# (Obtén estas credenciales en https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Modo Demo / Mock (Opcional: true permite probar el tablero y sincronización sin configurar Google Cloud)
ENABLE_DEMO_MODE=true
